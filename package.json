{
  "name": "leeloo-multipass-sdk",
  "version": "0.1.0",
  "description": "Leeloo Multipass SDK: launch a trusted cross-network Passport surface without passing credentials to the host app",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/index.js && node --check src/capabilities.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xirtus/leeloo-multipass-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/xirtus/leeloo-multipass-sdk/issues"
  },
  "author": "Andreas Xirtus"
}
